{
  "name": "exam-answer",
  "displayName": "考试作答",
  "description": "学生侧左侧面板：作答倒计时、题目列表与交卷。",
  "publisher": "numas",
  "version": "0.1.51",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0",
    "opensumi": "^3.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "numas",
    "exam",
    "answer",
    "panel"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "numas.exam.answer",
          "title": "作答",
          "icon": "media/answer.svg"
        }
      ]
    },
    "views": {
      "numas.exam.answer": [
        {
          "id": "numas.exam.answer.view",
          "name": "作答",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run compile",
    "package:vsix": "npx --yes @vscode/vsce@4.1.0 package --allow-missing-repository --skip-license --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js"
}
